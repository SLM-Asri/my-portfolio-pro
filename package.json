{
  "name": "asri-portfolio",
  "version": "1.0.0",
  "description": "Professional Portfolio for Sulaiman Lebbe Muhammad Asri - HND IT / Full-Stack Development",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "dev:client": "vite --host 0.0.0.0 --port 3000",
